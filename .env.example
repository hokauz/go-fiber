# Application
# development | production (docs hidden in production)
APP_ENV=development
CORS_ORIGINS=*
PORT=8080
SERVER_BASE_PATH=/api
SERVER_SHUTDOWN_TIMEOUT=15
SERVER_READ_TIMEOUT_SECONDS=5
SERVER_WRITE_TIMEOUT_SECONDS=15
SERVER_IDLE_TIMEOUT_SECONDS=60
METRICS_ENABLED=true
METRICS_PORT=9090
METRICS_PATH=/metrics
APP_METRICS_PREFIX=go_fiber_api
HEALTH_READY_CACHE_TTL_MS=300
HEALTH_READY_CB_FAILURE_THRESHOLD=5
HEALTH_READY_CB_TIMEOUT_SECONDS=5
HEALTH_READY_CB_SUCCESS_THRESHOLD=1
HEALTH_READY_CB_HALF_OPEN_MAX_CONCURRENT=1

# Auth (JWT/OIDC)
# Required when using protected routes. Leave empty to disable auth.
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_ALLOWED_ALGS=RS256
# Full URL to JWKS JSON (e.g. Supabase: https://<project>.supabase.co/auth/v1/.well-known/jwks.json)
AUTH_JWKS_URL=
AUTH_JWKS_TTL_SECONDS=600
AUTH_HTTP_TIMEOUT_SECONDS=3

# Database
DB_URL=
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_SECONDS=300
DB_PING_TIMEOUT_SECONDS=5

# Supabase (somente CI: docker e2e-supa)
# Variáveis com prefixo SUPABASE_* são usadas apenas no ambiente de CI/e2e.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
